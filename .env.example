# Apex Ops local development
# Copy to .env.local. Do not commit real credentials.

# Database
# Defaults to .data/pg
# PGDATA_DIR=.data/pg

# Demo login
# Set these before running db/seed.ts in a shared environment.
# SEED_USER_PASSWORD=<local-demo-password>
# SEED_TOTP_SECRET=<base32-totp-secret>

# Show MFA setup hints in development only.
DEMO_MFA_HINT=1

# Stripe
# Required for real checkout and webhook verification.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_ENTERPRISE=

# Use the local billing fixture when running without Stripe.
# Do not enable this in production.
BILLING_DEMO_MODE=true
